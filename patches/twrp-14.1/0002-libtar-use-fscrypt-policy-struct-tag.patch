From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Samurai recovery build <samurai@localhost>
Date: Thu, 16 Jul 2026 00:00:01 +0600
Subject: [PATCH] libtar: use the fscrypt policy struct tag

Android 14's UAPI defines fscrypt_policy as a macro expanding to the
fscrypt_policy_v1 struct tag, not as a typedef.  Use the struct spelling for
the pointer, allocation casts, and sizeof expressions.
---
 libtar/append.c | 2 +-
 libtar/block.c  | 2 +-
 libtar/libtar.h | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/libtar/append.c b/libtar/append.c
index 23d2b7e..d25ac85 100644
--- a/libtar/append.c
+++ b/libtar/append.c
@@ -143,7 +143,7 @@ th_read(TAR *t, const char *realname)
 			free(t->th_buf.fep);
 			t->th_buf.fep = NULL;
 		}
-		t->th_buf.fep = (fscrypt_policy *)malloc(sizeof(fscrypt_policy));
+		t->th_buf.fep = (struct fscrypt_policy *)malloc(sizeof(struct fscrypt_policy));
 		if (!t->th_buf.fep) {
 			LOG("malloc fs_encryption_policy\n");
 			return -1;
diff --git a/libtar/block.c b/libtar/block.c
index f3efbec..08b9718 100644
--- a/libtar/block.c
+++ b/libtar/block.c
@@ -354,7 +354,7 @@ th_read_internal(TAR *t)
 #ifdef USE_FSCRYPT
 			start = strstr(buf, FSCRYPT_TAG);
 			if (start && start+FSCRYPT_TAG_LEN < buf+len) {
-				t->th_buf.fep = (fscrypt_policy*)malloc(sizeof(fscrypt_policy));
+				t->th_buf.fep = (struct fscrypt_policy*)malloc(sizeof(struct fscrypt_policy));
 				if (!t->th_buf.fep) {
 					LOG("malloc failed for fscrypt policy\n");
 					return -1;
diff --git a/libtar/libtar.h b/libtar/libtar.h
index 761cd68..7447ad5 100644
--- a/libtar/libtar.h
+++ b/libtar/libtar.h
@@ -71,7 +71,7 @@ struct tar_header
 	char *gnu_longlink;
 	char *selinux_context;
 #ifdef USE_FSCRYPT
-	fscrypt_policy  *fep;
+	struct fscrypt_policy *fep;
 #endif
 	int has_cap_data;
 	struct vfs_cap_data cap_data;
-- 
2.43.0
