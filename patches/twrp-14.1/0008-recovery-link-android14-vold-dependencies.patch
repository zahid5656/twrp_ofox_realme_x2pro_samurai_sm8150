From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Samurai recovery build <samurai@localhost>
Date: Thu, 16 Jul 2026 00:00:07 +0600
Subject: [PATCH] recovery: link Android 14 vold dependencies

The recovery executable embeds libvold as a static library, so its Android 14
dependencies are not propagated automatically.  Link the same async-safe,
boot-AIDL, and netlink dependencies already required by libtar's vold usage.
---
 Android.mk | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Android.mk b/Android.mk
--- a/Android.mk
+++ b/Android.mk
@@ -138,7 +138,7 @@ LOCAL_C_INCLUDES += \
     $(LOCAL_PATH)/twinstall/include
 
-LOCAL_STATIC_LIBRARIES += libguitwrp libvold
-LOCAL_SHARED_LIBRARIES += libz libc libcutils libstdc++ libtar libblkid libminuitwrp libmtdutils libtwadbbu
+LOCAL_STATIC_LIBRARIES += libguitwrp libvold libdm libasync_safe
+LOCAL_SHARED_LIBRARIES += libz libc libcutils libstdc++ libtar libblkid libminuitwrp libmtdutils libtwadbbu libsysutils android.hardware.boot-V1-ndk
 LOCAL_SHARED_LIBRARIES += libbootloader_message libcrecovery libtwrpdigest libc++ libaosprecovery libcrypto libbase 
 LOCAL_SHARED_LIBRARIES += libziparchive libselinux libdl_android.bootstrap
 
