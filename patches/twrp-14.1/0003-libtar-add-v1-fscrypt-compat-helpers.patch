From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Samurai recovery build <samurai@localhost>
Date: Thu, 16 Jul 2026 00:00:02 +0600
Subject: [PATCH] libtar: add Android 14 fscrypt v1 compatibility helpers

TeamWin libtar still calls the fscrypt policy-union helpers that were present
in older vold branches.  Android 14's vold selects the policy version at build
time and no longer exports those helpers.  The Samurai tree explicitly selects
policy v1, so provide the equivalent v1-only inline operations in libtar.

Also pass the archived policy-type descriptor to lookup_ref_tar(), matching its
Android 14 signature.
---
 libtar/extract.c |  2 +-
 libtar/libtar.h  | 40 ++++++++++++++++++++++++++++++++++++++++
 2 files changed, 41 insertions(+), 1 deletion(-)

diff --git a/libtar/extract.c b/libtar/extract.c
index 15127ab..5b13c62 100644
--- a/libtar/extract.c
+++ b/libtar/extract.c
@@ -570,7 +570,7 @@ tar_extract_dir(TAR *t, const char *realname)
 		uint8_t binary_policy[size];
 		memset(&binary_policy, 0, size);
 
-		if (!lookup_ref_tar(t->th_buf.fep, &binary_policy[0])) {
+		if (!lookup_ref_tar(descriptor, &binary_policy[0])) {
 			LOG("error looking up fscrypt policy for '%s' - %s\n", realname, descriptor);
 			policy_lookup_error = true;
 		}
diff --git a/libtar/libtar.h b/libtar/libtar.h
index 7447ad5..ac4b15f 100644
--- a/libtar/libtar.h
+++ b/libtar/libtar.h
@@ -12,15 +12,55 @@
 #ifndef LIBTAR_H
 #define LIBTAR_H
 
+#include <stdio.h>
 #include <sys/types.h>
 #include <sys/stat.h>
 #include <linux/capability.h>
 #include "tar.h"
 
 #include "libtar_listhash.h"
 
 #ifdef USE_FSCRYPT
 #include "fscrypt_policy.h"
+
+/*
+ * Android 14 vold no longer exports the policy-union accessors used by
+ * TeamWin's libtar.  TW_USE_FSCRYPT_POLICY=1 selects the v1 structure for
+ * Samurai, so keep the compatibility operations local to libtar.
+ */
+static inline uint8_t *get_policy_descriptor(struct fscrypt_policy_v1 *policy)
+{
+	return policy ? policy->master_key_descriptor : NULL;
+}
+
+static inline uint8_t get_policy_size(struct fscrypt_policy_v1 *policy, bool hex)
+{
+	if (!policy)
+		return 0;
+	return hex ? FS_KEY_DESCRIPTOR_SIZE_HEX : FSCRYPT_KEY_DESCRIPTOR_SIZE;
+}
+
+static inline void *get_policy(const struct fscrypt_policy_v1 *policy)
+{
+	return (void *)policy;
+}
+
+static inline int fscrypt_policy_size(const struct fscrypt_policy_v1 *policy)
+{
+	return policy ? (int)sizeof(*policy) : 0;
+}
+
+static inline void get_policy_content(struct fscrypt_policy_v1 *policy,
+		char *content)
+{
+	if (!policy || !content)
+		return;
+	snprintf(content, 50, "%u %u %u %u",
+		(unsigned int)policy->version,
+		(unsigned int)policy->contents_encryption_mode,
+		(unsigned int)policy->filenames_encryption_mode,
+		(unsigned int)policy->flags);
+}
 #endif
 
 #ifdef __cplusplus
-- 
2.43.0
