From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Samurai recovery build <samurai@localhost>
Date: Thu, 16 Jul 2026 00:00:05 +0600
Subject: [PATCH] recovery: tear down FBE userdata with libdm

The legacy delete_crypto_blk_dev() entry point is not exported by Android 14
vold.  For metadata-FBE builds, remove the active userdata mapping through the
current libdm API before formatting the physical data partition.  Keep the
legacy call for non-FBE configurations.
---
 partition.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/partition.cpp b/partition.cpp
--- a/partition.cpp
+++ b/partition.cpp
@@ -32,6 +32,9 @@
 #include <android-base/properties.h>
 #include <android-base/strings.h>
 #include <libsnapshot/snapshot.h>
+#ifdef TW_INCLUDE_FBE
+#include <libdm/dm.h>
+#endif
 
 #include "cutils/properties.h"
 #include "libblkid/include/blkid.h"
@@ -2164,8 +2167,12 @@ bool TWPartition::Wipe_Encryption() {
 	if (!UnMount(true))
 		return false;
 	if (Is_Decrypted && !Decrypted_Block_Device.empty()) {
+#ifdef TW_INCLUDE_FBE
+		if (!android::dm::DeviceMapper::Instance().DeleteDeviceIfExists("userdata")) {
+#else
 		if (delete_crypto_blk_dev((char*)("userdata")) != 0) {
+#endif
 			LOGERR("Error deleting crypto block device, continuing anyway.\n");
 		}
 	}
 #endif
-- 
