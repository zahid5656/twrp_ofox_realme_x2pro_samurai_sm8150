From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Samurai recovery build <samurai@localhost>
Date: Thu, 16 Jul 2026 00:00:03 +0600
Subject: [PATCH] libtar: link required Android 14 vold dependencies

libtar embeds the Android 14 libvold static library for FBE support.  Static
library dependencies do not propagate into this Android.mk target, so provide
the boot-control, netlink, and async-safe libraries required by the vold object
files selected by the linker.
---
 libtar/Android.mk | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/libtar/Android.mk b/libtar/Android.mk
index c1d27c2..3a50356 100644
--- a/libtar/Android.mk
+++ b/libtar/Android.mk
@@ -15,9 +15,11 @@ LOCAL_C_INCLUDES += external/libselinux/include
 LOCAL_SHARED_LIBRARIES += libselinux
 
 ifeq ($(TW_INCLUDE_CRYPTO_FBE), true)
-    LOCAL_STATIC_LIBRARIES += libvold libscrypt_static
+    LOCAL_STATIC_LIBRARIES += libvold libscrypt_static libasync_safe
     LOCAL_SHARED_LIBRARIES +=  \
         android.hardware.boot@1.0 \
+        android.hardware.boot-V1-ndk \
+        libboot_control_client \
         android.hardware.confirmationui@1.0 \
         android.hardware.gatekeeper@1.0 \
         android.hardware.keymaster@3.0 \
@@ -52,6 +54,7 @@ ifeq ($(TW_INCLUDE_CRYPTO_FBE), true)
         libkeyutils \
         liblog \
         libhwbinder \
+        libsysutils \
         libchrome \
         libbootloader_message \
         libgatekeeper_aidl
