From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Samurai recovery build <samurai@localhost>
Date: Thu, 16 Jul 2026 00:00:04 +0600
Subject: [PATCH] recovery: exclude removed FDE API from FBE-only builds

Android 14 vold no longer exposes the legacy cryptfs FDE entry points still
referenced by TeamWin recovery.  Samurai uses metadata FBE and explicitly
enables TW_INCLUDE_FBE, so do not compile the obsolete block-encryption
fallback in that configuration.  Keep the old code intact for non-FBE builds
instead of providing fake cryptfs stubs.
---
 partition.cpp        | 4 ++++
 partitionmanager.cpp | 9 +++++++++
 2 files changed, 13 insertions(+)

diff --git a/partition.cpp b/partition.cpp
--- a/partition.cpp
+++ b/partition.cpp
@@ -708,6 +708,9 @@ void TWPartition::Setup_Data_Partition(bool Display_Error) {
 	} else if (!Mount(false)) {
 		if (Is_Present) {
 			if (Key_Directory.empty()) {
+#ifdef TW_INCLUDE_FBE
+				LOGERR("Unable to mount /data: no FBE key directory is configured and legacy FDE is unavailable.\n");
+#else
 				set_partition_data(Use_Original_Path ? Original_Path.c_str() : Actual_Block_Device.c_str(), Crypto_Key_Location.c_str());
 				if (cryptfs_check_footer() == 0) {
 					Is_Encrypted = true;
@@ -727,6 +730,7 @@ void TWPartition::Setup_Data_Partition(bool Display_Error) {
 				} else {
 					gui_err("mount_data_footer=Could not mount /data and unable to find crypto footer.");
 				}
+#endif
 			} else {
 				Is_Encrypted = true;
 				Is_Decrypted = false;
diff --git a/partitionmanager.cpp b/partitionmanager.cpp
--- a/partitionmanager.cpp
+++ b/partitionmanager.cpp
@@ -624,6 +624,7 @@ void TWPartitionManager::Set_Crypto_State() {
 				}
 			}
 		} else {
+#ifndef TW_INCLUDE_FBE
 			LOGINFO("FBE setup failed. Trying FDE...\n");
 			Set_Crypto_State();
 			Set_Crypto_Type("block");
@@ -643,5 +644,6 @@ void TWPartitionManager::Set_Crypto_State() {
 				DataManager::SetValue("tw_crypto_pwtype_0", password_type);
 			}
+#endif
 		}
 	}
 	if (Decrypt_Data && (!Decrypt_Data->Is_Encrypted || Decrypt_Data->Is_Decrypted)) {
@@ -2099,7 +2101,9 @@ void TWPartitionManager::Check_Users_Decryption_Status() {
 
 int TWPartitionManager::Decrypt_Device(string Password, int user_id) {
 #ifdef TW_INCLUDE_CRYPTO
+#ifndef TW_INCLUDE_FBE
 	char crypto_blkdev[PROPERTY_VALUE_MAX];
+#endif
 	std::vector<TWPartition*>::iterator iter;
 
 	// Mount any partitions that need to be mounted for decrypt
@@ -2169,6 +2173,10 @@ int TWPartitionManager::Decrypt_Device(string Password, int user_id) {
 		return -1;
 	}
 
+#ifdef TW_INCLUDE_FBE
+	LOGERR("Legacy FDE decryption is unavailable in this FBE-only build.\n");
+	return -1;
+#else
 	char isdecrypteddata[PROPERTY_VALUE_MAX];
 	property_get("twrp.decrypt.done", isdecrypteddata, "");
 	if (strcmp(isdecrypteddata, "true") == 0) {
@@ -2220,6 +2228,7 @@ int TWPartitionManager::Decrypt_Device(string Password, int user_id) {
 		Post_Decrypt(crypto_blkdev);
 	}
 	return 0;
+#endif
 #else
 	gui_err("no_crypto_support=No crypto support was compiled into this build.");
 	return -1;
-- 
