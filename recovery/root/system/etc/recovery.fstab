# Android fstab file adapted for TWRP. Partition presentation and backup flags
# are kept in twrp.flags; only mount/decryption-critical entries belong here.

#<src>                                                   <mnt_point>  <type>  <mnt_flags and options>                                           <fs_mgr_flags>
/dev/block/bootdevice/by-name/metadata                   /metadata    ext4    noatime,nosuid,nodev                                            wait,check,formattable,metadata_csum
/dev/block/bootdevice/by-name/userdata                   /data        ext4    noatime,nosuid,nodev,barrier=1,noauto_da_alloc,errors=panic,inlinecrypt  wait,check,quota,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,wrappedkey,keydirectory=/metadata/vold/metadata_encryption
/dev/block/bootdevice/by-name/userdata                   /data        f2fs    noatime,nosuid,nodev,discard,fsync_mode=nobarrier,inlinecrypt    wait,check,formattable,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,wrappedkey,keydirectory=/metadata/vold/metadata_encryption

# update_engine uses this entry to resolve the boot-device address.
/dev/block/bootdevice/by-name/misc                       /misc        emmc    defaults                                                        defaults
