# =======================================================
# OrangeFox USB, MTP, and Controller Fallbacks
# =======================================================
sys.usb.controller=a600000.dwc3
sys.usb.rndis.func.name=rndis_bam
sys.usb.rmnet.func.name=rmnet_bam
persist.sys.isUsbOtgEnabled=true
persist.sys.usb.config=mtp,adb
ro.sys.usb.storage.type=mtp

# =======================================================
# OrangeFox Gatekeeper / Keymaster & Force ADB access 
# =======================================================
vendor.gatekeeper.disable_spu=true
keymaster_ver=4.0
ro.adb.secure=0
ro.product.board=msmnile
ro.board.platform=msmnile

# =======================================================
# OrangeFox Cryptography Architecture (FBE Mapping)
# =======================================================
ro.crypto.volume.filenames_mode=aes-256-cts
ro.crypto.allow_encrypt_override=true
ro.crypto.dm_default_key.options_format.version=2
ro.crypto.volume.metadata.method=dm-default-key
ro.crypto.volume.options=aes-256-xts:aes-256-cts:v2
